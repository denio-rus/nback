<% content_for :title, t(".title") %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>

  <div id="<%= dom_id @user %>" class="w-full sm:w-auto my-5 space-y-5">
    <div>
      <strong class="block font-medium mb-1"><%= t(".nickname") %>:</strong>
      <%= @user.nickname %>
    </div>
  
    <div>
      <strong class="block font-medium mb-1"><%= t(".email") %>:</strong>
      <%= @user.email_address %>
    </div>
  </div>

  <%= link_to t(".edit"), edit_user_path(@user), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-surface-raised border border-line hover:bg-surface inline-block font-medium" %>
  <%= button_to t(".destroy"), [:admin, @user], method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-accent-ink bg-danger hover:opacity-90 font-medium cursor-pointer", data: { turbo_confirm: t(".confirm_destroy") } %>
</div>
