<%# A scatter chart of play-throughs. Each point is a link to its breakdown page.
    The group is told by the shape (circle or diamond), not only by the color.
    locals: chart (id), x_kind (:date or :sleep), x_label, strategy, groups. %>
<%
  width = InsightsHelper::CHART_WIDTH
  height = InsightsHelper::CHART_HEIGHT
  all_points = groups.flat_map { |group| group[:points] }
  xs = all_points.map { |point| x_kind == :date ? point.played_on.jd : point.sleep_hours.to_f }
  ys = all_points.map(&:metric)
  x_pos = chart_scale(xs, width, padding: 56)
  y_pos = chart_scale(ys, height, padding: 28, invert: true)
  position = all_points.each_with_index.to_h { |point, index| [ point, [ x_pos[index], y_pos[index] ] ] }
  low_x, high_x = x_kind == :date ? all_points.map(&:played_on).minmax.map(&:iso8601) : xs.minmax.map { |value| format_number(value) }
  low_y, high_y = ys.minmax.map { |value| format_number(value) }
%>
<svg data-chart="<%= chart %>" viewBox="0 0 <%= width %> <%= height + 36 %>" class="mt-3 w-full h-auto" role="group">
  <line x1="12" y1="<%= height - 12 %>" x2="<%= width - 12 %>" y2="<%= height - 12 %>" class="stroke-line" stroke-width="1" />
  <line x1="12" y1="12" x2="12" y2="<%= height - 12 %>" class="stroke-line" stroke-width="1" />
  <text x="18" y="22" font-size="11" class="fill-ink-muted"><%= high_y %></text>
  <text x="18" y="<%= height - 18 %>" font-size="11" class="fill-ink-muted"><%= low_y %></text>
  <text x="12" y="<%= height + 8 %>" font-size="11" class="fill-ink-muted"><%= low_x %></text>
  <text x="<%= width - 12 %>" y="<%= height + 8 %>" font-size="11" text-anchor="end" class="fill-ink-muted"><%= high_x %></text>
  <text data-axis-label x="<%= width / 2 %>" y="<%= height + 28 %>" font-size="12" text-anchor="middle" class="fill-ink-muted"><%= x_label %></text>

  <% groups.each do |group| %>
    <g data-group="<%= group[:name] %>">
      <% group[:points].each do |point| %>
        <% cx, cy = position.fetch(point) %>
        <a href="<%= game_session_path(point.session_id) %>" data-point>
          <title><%= t("insights.show.point_title", date: point.played_on.iso8601, value: point_label(point, strategy)) %></title>
          <% if group[:shape] == :diamond %>
            <polygon points="<%= cx %>,<%= cy - 7 %> <%= cx + 7 %>,<%= cy %> <%= cx %>,<%= cy + 7 %> <%= cx - 7 %>,<%= cy %>" class="fill-ink-muted" />
          <% else %>
            <circle cx="<%= cx %>" cy="<%= cy %>" r="6" class="fill-accent" />
          <% end %>
        </a>
      <% end %>
    </g>
  <% end %>
</svg>
