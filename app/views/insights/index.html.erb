<% content_for :title, t(".title") %>

<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-bold"><%= t(".title") %></h1>
  <p class="mt-2 text-ink-muted"><%= t(".intro") %></p>

  <% @sections.each do |category| %>
    <section data-category="<%= category %>" class="mt-8">
      <h2 class="font-bold text-xl"><%= t("games.categories.#{category}") %></h2>
      <ul class="mt-3 space-y-2">
        <% @games_by_category[category].each do |game| %>
          <% count = @counts.fetch(game.id, 0) %>
          <li data-game="<%= game.id %>" class="flex items-center justify-between gap-4 bg-surface-raised border border-line rounded-xl px-4 py-3">
            <span class="font-medium"><%= game.title %></span>
            <% if count.positive? %>
              <span class="text-ink-muted"><%= t("insights.summary.count", count: count) %></span>
              <%= link_to t(".open"), insight_path(game), class: "px-4 py-2 bg-accent hover:opacity-90 text-accent-ink rounded-lg" %>
            <% else %>
              <span class="text-ink-muted"><%= t(".no_plays") %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
