<%# Plain links to the current page in every language; nothing is stored. %>
<div class="flex items-center gap-2 text-sm">
  <% I18n.available_locales.each do |locale| %>
    <%= link_to t("languages.#{locale}"), url_for(locale: locale),
                class: "hover:text-white/80 transition #{'font-bold' if locale == I18n.locale}",
                aria: { current: ("true" if locale == I18n.locale) },
                lang: locale %>
  <% end %>
</div>
