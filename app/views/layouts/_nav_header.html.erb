<nav class="bg-accent text-accent-ink shadow-lg fixed w-full z-50">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex justify-between items-center h-16">
      
      <!-- Logo -->
      <%= link_to games_path, class: "flex items-center gap-3 group" do %>
        <div class="w-14 h-14 bg-accent-ink rounded-2xl flex items-center justify-center text-accent font-bold text-2xl transition-transform group-hover:rotate-12">
          MAP
        </div>
        <span class="font-bold text-2xl tracking-tight">MindAtPlay</span>
      <% end %>

      <div class="flex items-center gap-8">
        <%= render "layouts/language_switcher" %>
        <%= render "layouts/theme_switcher" %>
        <%= link_to t("layout.nav.games"), games_path, class: "hover:text-accent-ink/80 transition font-medium" %>
        <%= link_to t("layout.nav.news"), news_path, class: "hover:text-accent-ink/80 transition font-medium whitespace-nowrap" %>
        <%= link_to t("layout.nav.articles"), articles_path, class: "hover:text-accent-ink/80 transition font-medium whitespace-nowrap" %>
        <%= link_to t("layout.nav.about"), about_path, class: "hover:text-accent-ink/80 transition font-medium whitespace-nowrap" %>
        <% if Current.user %>
          <%= link_to t("layout.nav.insights"), insights_path, class: "hover:text-accent-ink/80 transition font-medium whitespace-nowrap" %>
        <% end %>
        <% if Current.user&.has_role?(:admin) %>
          <%= link_to t("layout.nav.admin_users"), admin_users_path, class: "hover:text-accent-ink/80 transition font-medium whitespace-nowrap" %>
          <%= link_to t("layout.nav.admin_feedback"), admin_feedback_messages_path, class: "hover:text-accent-ink/80 transition font-medium whitespace-nowrap" %>
        <% end %>

        <div class="flex items-center gap-4">
          <% if Current.user %>
            <div class="flex items-center gap-3">
              <span class="text-sm opacity-90"><%= Current.user.nickname %></span>
              
              <%= link_to t("layout.nav.profile"), user_path(Current.user), class: "hover:text-accent-ink/80 transition" %>
              
              <%= button_to t("layout.nav.sign_out"), session_path, method: :delete,
                           class: "px-5 py-2 bg-accent-ink/10 hover:bg-accent-ink/20 rounded-xl text-sm font-medium transition backdrop-blur-sm" %>
            </div>
          <% else %>
            <div class="flex items-center gap-3">
              <%= link_to t("layout.nav.sign_in"), new_session_path, class: "hover:text-accent-ink/80 transition font-medium" %>
              <%= link_to t("layout.nav.sign_up"), new_registration_path, 
                         class: "px-6 py-2.5 bg-accent-ink text-accent font-semibold rounded-2xl hover:bg-accent-ink/90 transition shadow-sm" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</nav>