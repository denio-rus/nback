<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>

  <%= form_with url: session_url, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.text_field :nickname, required: true, autofocus: true, autocomplete: "username", placeholder: t(".nickname_placeholder"), value: params[:nickname], maxlength: 20, class: "block shadow-sm rounded-md border border-line focus:outline-accent px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: t(".password_placeholder"), maxlength: 72, class: "block shadow-sm rounded-md border border-line focus:outline-accent px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <div class="inline">
        <%= form.submit t(".submit"), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-accent hover:opacity-90 text-accent-ink inline-block font-medium cursor-pointer" %>
      </div>

      <div class="mt-4 text-sm text-ink-muted sm:mt-0">
        <%= link_to t(".forgot_password"), new_password_path, class: "text-ink underline hover:no-underline" %>
      </div>
    </div>
  <% end %>
</div>
