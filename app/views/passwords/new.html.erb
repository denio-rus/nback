<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t(".title") %></h1>

  <%= form_with url: passwords_path, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", placeholder: t(".email_placeholder"), value: params[:email], class: "block shadow-sm rounded-md border border-line focus:outline-solid focus:outline-accent px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="inline">
      <%= form.submit t(".submit"), class: "w-full sm:w-auto text-center rounded-lg px-3.5 py-2.5 bg-accent hover:opacity-90 text-accent-ink inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>
