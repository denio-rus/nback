<% content_for :title, t(".title") %>

<div class="max-w-xl mx-auto">
  <h1 class="font-bold text-3xl"><%= t(".title") %></h1>
  <p class="mt-3 text-ink-muted"><%= t(".privacy") %></p>

  <%= form_with model: @feedback_message, url: feedback_messages_path, class: "mt-6" do |form| %>
    <% if @feedback_message.errors.any? %>
      <div id="error_explanation" class="bg-surface-raised border border-danger text-danger px-3 py-2 font-medium rounded-md">
        <ul class="list-disc ml-6">
          <% @feedback_message.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# Trap for bots: hidden for people, ignored by assistive tools. %>
    <div class="hidden" aria-hidden="true">
      <%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %>
    </div>

    <div class="my-5">
      <%= form.label :kind, t(".kind") %>
      <%= form.select :kind, FeedbackMessage::KINDS.map { |kind| [ t("feedback.kinds.#{kind}"), kind ] },
                      {}, class: "block shadow-sm rounded-md border border-line px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.label :body, t(".body") %>
      <%= form.text_area :body, rows: 8, maxlength: FeedbackMessage::MAX_BODY, required: true,
                         class: "block shadow-sm rounded-md border border-line px-3 py-2 mt-2 w-full" %>
    </div>

    <%= form.submit t(".submit"), class: "rounded-md px-3.5 py-2.5 bg-accent text-accent-ink hover:opacity-90 font-medium cursor-pointer" %>
  <% end %>
</div>
