<div data-controller="games--nback" 
     data-games--nback-submit-url-value="<%= submit_result_game_game_session_path(@game, @game_session) %>"
     data-games--nback-messages-value="<%= t("games.nback.ui").to_json %>"
     data-games--nback-n-value="<%= @game_session.setup_game["n"] %>"
     data-games--nback-stimulus-duration-value="<%= @game_session.setup_game["stimulus_duration"] %>"
     data-games--nback-sequence-value="<%= @game_session.setup_game["sequence"].to_json %>">

  <h1 class="text-3xl font-bold mb-6 text-center"><%= t("games.nback.ui.title", n: @game_session.setup_game["n"]) %></h1>

  <p data-games--nback-target="status" class="text-xl mb-8">
    <%= t("games.nback.ui.press_start") %>
  </p>

  <!-- current stimulus -->
  <div class="flex justify-center mb-8">
    <div data-games--nback-target="stimulus"
         class="w-40 h-40 bg-surface-raised border border-line text-ink text-7xl flex items-center justify-center rounded-3xl font-bold transition-all">
      ?
    </div>
  </div>

  <!-- controls -->
  <div class="flex justify-center gap-4">
    <button data-action="click->games--nback#start"
            data-games--nback-target="startBtn"
            class="px-8 py-4 bg-accent hover:opacity-90 text-accent-ink rounded-2xl text-lg font-semibold">
      <%= t("games.nback.ui.start") %>
    </button>

    <button data-action="click->games--nback#match"
            data-games--nback-target="matchBtn"
            class="px-8 py-4 bg-accent hover:opacity-90 text-accent-ink rounded-2xl text-lg font-semibold">
      <%= t("games.nback.ui.match") %>
    </button>
  </div>

  <!-- results -->
  <div class="mt-8 text-center text-sm text-ink-muted">
    <%= t("games.nback.ui.correct") %>: <span data-games--nback-target="correct">0</span> / 
    <%= t("games.nback.ui.errors") %>: <span data-games--nback-target="errors">0</span>
  </div>
</div>
