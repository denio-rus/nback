<div data-controller="games--adaptive-reaction-test" 
     data-games--adaptive-reaction-test-submit-url-value="<%= submit_result_game_game_session_path(@game, @game_session) %>"
     data-games--adaptive-reaction-test-messages-value="<%= t("games.adaptive_reaction_test.ui").to_json %>"
     data-games--adaptive-reaction-test-sequence-value="<%= @game_session.setup_game["sequence"].to_json %>"
     data-games--adaptive-reaction-test-stimulus-duration-value="<%= @game_session.setup_game["stimulus_duration"].to_json %>"> 

  <h1 class="text-3xl font-bold mb-6"><%= t("games.adaptive_reaction_test.ui.title") %></h1>

  <p data-games--adaptive-reaction-test-target="status" class="text-xl mb-8">
    <%= t("games.adaptive_reaction_test.ui.press_start") %>
  </p>

  <div class="flex justify-center mb-10">
    <div data-games--adaptive-reaction-test-target="circle"
         class="w-52 h-52 rounded-full bg-gray-700 transition-colors duration-100 shadow-xl">
    </div>
  </div>

<div class="text-center">
  <button data-action="click->games--adaptive-reaction-test#start"
          data-games--adaptive-reaction-test-target="startBtn"
          class="px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-lg font-medium">
    <%= t("games.adaptive_reaction_test.ui.start") %>
  </button>
</div>
  <div data-games--adaptive-reaction-test-target="results" 
       class="mt-12 max-w-md mx-auto text-lg">
  </div>
</div>
