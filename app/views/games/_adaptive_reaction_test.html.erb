<div data-controller="games--adaptive-reaction-test"
     data-games--adaptive-reaction-test-submit-url-value="<%= submit_result_game_game_session_path(@game, @game_session) %>"
     data-games--adaptive-reaction-test-messages-value="<%= t("games.adaptive_reaction_test.ui").to_json %>"
     data-games--adaptive-reaction-test-sequence-value="<%= @game_session.setup_game["sequence"].to_json %>"
     data-games--adaptive-reaction-test-rules-value="<%= @game_session.setup_game["rules"].to_json %>"
     data-games--adaptive-reaction-test-stimulus-duration-value="<%= @game_session.setup_game["stimulus_duration"].to_json %>">

  <h1 class="text-3xl font-bold mb-6"><%= t("games.adaptive_reaction_test.ui.title") %></h1>

  <p data-games--adaptive-reaction-test-target="status" class="text-xl mb-4">
    <%= t("games.adaptive_reaction_test.ui.press_start") %>
  </p>

  <p data-games--adaptive-reaction-test-target="rule" class="text-lg mb-6 text-ink-muted"></p>

  <div class="flex justify-center mb-8">
    <div data-games--adaptive-reaction-test-target="circle"
         class="w-52 h-52 rounded-full bg-ink-muted transition-colors duration-100 shadow-xl">
    </div>
  </div>

  <div class="text-center">
    <button data-action="click->games--adaptive-reaction-test#start"
            data-games--adaptive-reaction-test-target="startBtn"
            class="px-8 py-4 bg-accent hover:opacity-90 text-accent-ink rounded-xl text-lg font-medium">
      <%= t("games.adaptive_reaction_test.ui.start") %>
    </button>
    <button data-action="click->games--adaptive-reaction-test#beginPart"
            data-games--adaptive-reaction-test-target="continueBtn"
            class="hidden px-8 py-4 bg-accent hover:opacity-90 text-accent-ink rounded-xl text-lg font-medium">
      <%= t("games.adaptive_reaction_test.ui.begin_part") %>
    </button>
    <div data-games--adaptive-reaction-test-target="answerButtons" class="hidden flex justify-center gap-6">
      <% %w[a b].each do |button| %>
        <button data-action="click->games--adaptive-reaction-test#answer"
                data-games--adaptive-reaction-test-target="answerBtn"
                data-button="<%= button %>"
                class="w-32 py-4 bg-accent hover:opacity-90 text-accent-ink rounded-xl text-2xl font-semibold">
          <%= t("games.adaptive_reaction_test.ui.buttons.#{button}") %>
        </button>
      <% end %>
    </div>
  </div>
</div>
