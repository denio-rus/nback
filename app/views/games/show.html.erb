<div class="max-w-md mx-auto">
  <h2 class="text-2xl font-bold"><%= @game.title %></h2>
  <p class="mt-4 text-lg"><%= @game.description %></p>

  <%# The article is linked only when the strategy names one and it is published. %>
  <% article_slug = @game.game_strategy.article_slug %>
  <% if article_slug && Article.published.exists?(slug: article_slug) %>
    <p class="mt-4"><%= link_to t("articles.read_more"), article_path(slug: article_slug), class: "underline" %></p>
  <% end %>

  <div class="flex justify-center mt-12">
    <%# A signed in person may fill in the optional check-in first; an anonymous visitor starts at once. %>
    <% if authenticated? %>
      <%= link_to t(".play"), new_game_game_session_path(@game), class: "px-4 py-2 bg-accent hover:opacity-90 text-accent-ink rounded" %>
    <% else %>
      <%= link_to t(".play"), game_game_sessions_path(@game), data: { turbo_method: :post }, class: "px-4 py-2 bg-accent hover:opacity-90 text-accent-ink rounded" %>
    <% end %>
  </div>
</div>
