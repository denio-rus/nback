<div data-controller="games--stroop-test" 
     data-games--stroop-test-submit-url-value="<%= submit_result_game_game_session_path(@game, @game_session) %>"
     data-games--stroop-test-messages-value="<%= t("games.stroop_test.ui").to_json %>"
     data-games--stroop-test-sequence-value="<%= @game_session.setup_game["sequence"].to_json %>" 
     data-games--stroop-test-stimulus-duration-value="<%= @game_session.setup_game["stimulus_duration"].to_json %>"> 

  <h1 class="text-3xl font-bold mb-6 text-center"><%= t("games.stroop_test.ui.title") %></h1>

  <p data-games--stroop-test-target="status" class="text-xl mb-8">
    <%= t("games.stroop_test.ui.press_start") %>
  </p>

  <!-- current stimulus -->
  <div class="flex justify-center mb-8">
    <div data-games--stroop-test-target="stimulus"
         class="w-60 h-50 bg-surface-raised border border-line text-6xl flex items-center justify-center rounded-3xl font-bold transition-all">
      ?
    </div>
  </div>

  <!-- controls -->
  <div class="flex justify-center gap-4">
    <button data-action="click->games--stroop-test#start"
            data-games--stroop-test-target="startBtn"
            class="px-8 py-4 bg-accent hover:opacity-90 text-accent-ink rounded-2xl text-lg font-semibold">
      <%= t("games.stroop_test.ui.start") %>
    </button>
    <div class="grid grid-cols-2 gap-6 hidden" data-games--stroop-test-target="buttonsContainer">
      <% %w(green red blue yellow).each do |color| %>
        <button 
          data-action="click->games--stroop-test#selectColor"
          data-games--stroop-test-target="colorBtn"
          data-color="<%= color %>"
          class="px-8 py-4 bg-accent hover:opacity-90 text-accent-ink rounded-2xl text-lg font-semibold">
          <%= t("games.stroop_test.ui.colors.#{color}") %>
        </button>
      <% end %>
    </div>
  </div>

  <!-- results -->
  <div class="mt-8 text-center text-sm text-ink-muted">
    <%= t("games.stroop_test.ui.correct") %>: <span data-games--stroop-test-target="correct">0</span> / 
    <%= t("games.stroop_test.ui.errors") %>: <span data-games--stroop-test-target="errors">0</span>
  </div>
</div>
