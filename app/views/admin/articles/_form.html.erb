<% field_class = "block shadow-sm rounded-md border border-line bg-surface text-ink px-3 py-2 mt-2 w-full" %>

<%= form_with(model: [ :admin, article ], class: "contents") do |form| %>
  <% if article.errors.any? %>
    <div id="error_explanation" class="bg-surface-raised border border-danger text-danger px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= t("admin.articles.form.errors", count: article.errors.count) %></h2>

      <ul class="list-disc ml-6">
        <% article.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :slug, class: "font-medium" %>
    <%= form.text_field :slug, required: true, class: field_class, aria: { describedby: "slug_hint" } %>
    <p id="slug_hint" class="text-ink-muted text-sm mt-1"><%= t("admin.articles.form.slug_hint") %></p>
  </div>

  <div class="my-5">
    <%= form.label :kind, class: "font-medium" %>
    <%= form.select :kind, Article::KINDS.map { |kind| [ t("admin.articles.kinds.#{kind}"), kind ] }, {}, class: field_class %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :publish %>
    <%= form.checkbox :publish, class: "block shadow-sm rounded-md border border-line order-first h-5 w-5 focus:outline-accent" %>
  </div>

  <p data-markdown-hint class="text-ink-muted text-sm my-5"><%= t("admin.articles.form.markdown_hint") %></p>

  <%= form.fields_for :translations, translations do |translation_form| %>
    <% locale = translation_form.object.locale %>
    <fieldset class="my-5 p-4 border border-line rounded-md" data-locale="<%= locale %>">
      <legend class="px-2 font-medium"><%= t("languages.#{locale}") %></legend>
      <%= translation_form.hidden_field :locale %>

      <div>
        <%= translation_form.label :title, class: "font-medium" %>
        <%= translation_form.text_field :title, class: field_class %>
      </div>

      <div class="mt-4">
        <%= translation_form.label :body, class: "font-medium" %>
        <%= translation_form.text_area :body, rows: 12, class: field_class %>
      </div>

      <% unless locale.to_s == I18n.default_locale.to_s %>
        <p class="text-ink-muted text-sm mt-2"><%= t("admin.articles.form.optional_language") %></p>
      <% end %>
    </fieldset>
  <% end %>

  <div class="inline">
    <%= form.submit t("admin.articles.form.submit"), class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-accent hover:opacity-90 text-accent-ink inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
