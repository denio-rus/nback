<% content_for :title, "Users" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-surface-raised border border-success mb-5 text-success font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Users</h1>
  </div>

  <div id="users" class="min-w-full divide-y divide-line space-y-5">
    <% if @users.any? %>
      <% @users.each do |user| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render user %>
          <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
            <%= link_to "Show", admin_user_path(user), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-surface-raised border border-line hover:bg-surface inline-block font-medium" %>
            <%= link_to "Edit", edit_admin_user_path(user), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-surface-raised border border-line hover:bg-surface inline-block font-medium" %>
            <%= button_to "Destroy", admin_user_path(user), method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-accent-ink bg-danger hover:opacity-90 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No users found.</p>
    <% end %>
  </div>
</div>
