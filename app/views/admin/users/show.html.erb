<% content_for :title, "Showing user" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-surface-raised border border-success mb-5 text-success font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing user</h1>

  <%= render @user %>

  <%= link_to "Edit this user", edit_admin_user_path(@user), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-surface-raised border border-line hover:bg-surface inline-block font-medium" %>
  <%= link_to "Back to users", admin_users_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-surface-raised border border-line hover:bg-surface inline-block font-medium" %>
  <%= button_to "Destroy this user", [:admin, @user], method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-accent-ink bg-danger hover:opacity-90 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
</div>
