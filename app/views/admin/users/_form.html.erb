<%= form_with(model: [:admin, user], class: "contents") do |form| %>
  <% if user.errors.any? %>
    <div id="error_explanation" class="bg-surface-raised border border-danger text-danger px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h2>

      <ul class="list-disc ml-6">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <strong class="block font-medium mb-1">Nickname:</strong>
    <%= user.nickname %>
  </div>

  <div class="my-5 flex items-center gap-2">
    <%= form.label :active %>
    <%= form.checkbox :active, class: ["block shadow-sm rounded-md border order-first h-5 w-5", {"border-line focus:outline-accent": user.errors[:active].none?, "border-danger focus:outline-danger": user.errors[:active].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-accent hover:opacity-90 text-accent-ink inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
