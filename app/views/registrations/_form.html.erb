<%= form_with(url: registrations_path, model: user, class: "contents") do |form| %>
  <% if user.errors.any? %>
    <div id="error_explanation" class="bg-surface-raised border border-danger text-danger px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= t(".errors_header", count: user.errors.count) %></h2>

      <ul class="list-disc ml-6">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :nickname, t(".nickname") %>
    <p class="text-sm text-ink-muted"><%= t(".nickname_hint") %></p>
    <%= form.text_field :nickname, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-line focus:outline-accent": user.errors[:nickname].none?, "border-danger focus:outline-danger": user.errors[:nickname].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :email_address, t(".email") %>
    <%= form.text_field :email_address, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-line focus:outline-accent": user.errors[:email_address].none?, "border-danger focus:outline-danger": user.errors[:email_address].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :password, t(".password") %>
    <%= form.password_field :password, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-line focus:outline-accent": user.errors[:password].none?, "border-danger focus:outline-danger": user.errors[:password].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit t(".submit"), class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-accent hover:opacity-90 text-accent-ink inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
